extends ../layouts/main

block content

    .alert.alert-warning
        strong Attention :
        |  une localisation faisant l'objet d'un inventaire
        |  ne peut pas recevoir de mouvement pendant le comptage.

    .page-header
        div
            h1 Mouvement de stock
            p Ajouter ou retirer une quantité d'un emplacement

    .panel

        if error
            .alert.alert-danger
                = error

        form.form(
            action="/stock/movement"
            method="POST"
        )

            .form-row

                .form-group
                    label(for="type") Type

                    select#type(
                        name="type"
                        required
                    )
                        option(
                            value="IN"
                            selected=!form || !form.type || form.type === 'IN'
                        ) Entrée

                        option(
                            value="OUT"
                            selected=form && form.type === 'OUT'
                        ) Sortie

                .form-group
                    label(for="quantity") Quantité

                    input#quantity(
                        type="number"
                        name="quantity"
                        value=form && form.quantity ? form.quantity : ''
                        min="0.01"
                        step="0.01"
                        required
                    )

            .form-row

                .form-group
                    label(for="product_id") Produit

                    select#product_id(
                        name="product_id"
                        required
                    )
                        option(value="") -- Sélectionner --

                        each product in products
                            option(
                                value=product.id
                                selected=form && String(form.product_id) === String(product.id)
                            )
                                | #{product.sku} — #{product.name}

                .form-group
                    label(for="location_id") Emplacement

                    select#location_id(
                        name="location_id"
                        required
                    )
                        option(value="") -- Sélectionner --

                        each location in locations
                            option(
                                value=location.id
                                selected=form && String(form.location_id) === String(location.id)
                            )
                                | #{location.store_name} — #{location.name}

            .form-row

                .form-group
                    label(for="reference") Référence

                    input#reference(
                        type="text"
                        name="reference"
                        value=form && form.reference ? form.reference : ''
                        maxlength="100"
                        placeholder="Ex. BL-2026-001"
                    )

                .form-group
                    label(for="reason") Motif

                    input#reason(
                        type="text"
                        name="reason"
                        value=form && form.reason ? form.reason : ''
                        maxlength="255"
                        placeholder="Ex. Réception fournisseur"
                    )

            .form-actions

                a.btn.btn-secondary(
                    href="/stock"
                )
                    | Annuler

                button.btn.btn-primary(
                    type="submit"
                )
                    | Enregistrer le mouvement