extends ../layouts/main

block content

    .panel.form-panel

        .panel-header

            h2
                | Modifier l'emplacement


        .panel-body

            form(
                action="/stock-locations/" + location.id + "/edit"
                method="POST"
            )

                .form-group

                    label(for="store_id")
                        | Magasin

                    select.form-control(
                        id="store_id"
                        name="store_id"
                        required
                    )

                        each store in stores

                            if store.status === 'active' || store.id === location.store_id

                                option(
                                    value=store.id
                                    selected=store.id === location.store_id
                                )
                                    | #{store.name} (#{store.code})


                .form-group

                    label(for="name")
                        | Nom de l'emplacement

                    input.form-control(
                        type="text"
                        id="name"
                        name="name"
                        value=location.name
                        required
                    )


                .form-group

                    label(for="code")
                        | Code

                    input.form-control(
                        type="text"
                        id="code"
                        name="code"
                        value=location.code
                        required
                    )


                .form-group

                    label(for="description")
                        | Description

                    textarea.form-control(
                        id="description"
                        name="description"
                        rows="4"
                    ) #{location.description || ''}


                .form-group

                    label(for="status")
                        | Statut

                    select.form-control(
                        id="status"
                        name="status"
                    )

                        option(
                            value="active"
                            selected=location.status === 'active'
                        )
                            | Actif

                        option(
                            value="inactive"
                            selected=location.status === 'inactive'
                        )
                            | Inactif


                .form-actions

                    a.btn.btn-secondary(
                        href="/stock-locations"
                    )
                        | Annuler

                    button.btn.btn-primary(
                        type="submit"
                    )
                        | Enregistrer