extends ../layouts/main

block content

    .panel
        .panel-header
            div
                h1 Modifier le fournisseur
                p Modifier les informations du fournisseur

        .panel-body

        if error
            .alert.alert-danger
                = error
        
        form.form(
            action=`/suppliers/${supplier.id}/edit`
            method="POST"
        )

            .form-row

                .form-group
                    label(for="name") Nom
                    input#name(
                        type="text"
                        name="name"
                        value=supplier.name
                        required
                        maxlength="150"
                    )

                .form-group
                    label(for="code") Code
                    input#code(
                        type="text"
                        name="code"
                        value=supplier.code
                        required
                        maxlength="50"
                        style="text-transform: uppercase;"
                    )

            .form-row

                .form-group
                    label(for="contact_name") Nom du contact
                    input#contact_name(
                        type="text"
                        name="contact_name"
                        value=supplier.contact_name || ''
                        maxlength="150"
                    )

                .form-group
                    label(for="phone") Téléphone
                    input#phone(
                        type="text"
                        name="phone"
                        value=supplier.phone || ''
                        maxlength="50"
                    )

            .form-row

                .form-group
                    label(for="email") Email
                    input#email(
                        type="email"
                        name="email"
                        value=supplier.email || ''
                        maxlength="150"
                    )

                .form-group
                    label(for="address") Adresse
                    input#address(
                        type="text"
                        name="address"
                        value=supplier.address || ''
                        maxlength="255"
                    )

            .form-group
                label(for="status") Statut

                select#status(name="status")
                    option(
                        value="active"
                        selected=supplier.status === 'active'
                    ) Active

                    option(
                        value="inactive"
                        selected=supplier.status === 'inactive'
                    ) Inactive

            .form-actions
                a.btn.btn-secondary(
                    href="/suppliers"
                )
                    | Annuler

                button.btn.btn-primary(
                    type="submit"
                )
                    | Enregistrer