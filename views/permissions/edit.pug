extends ../layouts/main

block content

    .panel.form-panel

        .panel-header

            h2
                | Modifier la permission


        .panel-body

            form(
                action="/permissions/" + permission.id + "/edit"
                method="POST"
            )

                .form-group

                    label(for="name")
                        | Nom de la permission

                    input.form-control(
                        type="text"
                        id="name"
                        name="name"
                        value=permission.name
                        required
                    )


                .form-group

                    label(for="description")
                        | Description

                    textarea.form-control(
                        id="description"
                        name="description"
                        rows="4"
                    ) #{permission.description || ''}


                .form-actions

                    a.btn.btn-secondary(
                        href="/permissions"
                    )
                        | Annuler

                    button.btn.btn-primary(
                        type="submit"
                    )
                        | Enregistrer