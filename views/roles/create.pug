extends ../layouts/main

block content

    .panel.form-panel

        .panel-header
            h2
                | Créer un rôle

        .panel-body

            form(
                action="/roles/create"
                method="POST"
            )

                .form-group

                    label(
                        for="name"
                    )
                        | Nom du rôle

                    input.form-control(
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Ex: Administrateur"
                        required
                    )

                .form-group

                    label(
                        for="description"
                    )
                        | Description

                    textarea.form-control(
                        id="description"
                        name="description"
                        rows="4"
                        placeholder="Description du rôle"
                    )

                .form-actions

                    a.btn.btn-secondary(
                        href="/roles"
                    )
                        | Annuler

                    button.btn.btn-primary(
                        type="submit"
                    )
                        | Créer le rôle