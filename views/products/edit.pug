extends ../layouts/main

block content

    .page-header
        div
            h1 Modifier le produit
            p Modifier les informations du produit

    .panel

        if error
            .alert.alert-danger
                = error

        form.form(
            action=`/products/${product.id}/edit`
            method="POST"
        )

            .form-row

                .form-group
                    label(for="sku") SKU
                    input#sku(
                        type="text"
                        name="sku"
                        value=product.sku
                        required
                        maxlength="100"
                        style="text-transform: uppercase;"
                    )

                .form-group
                    label(for="name") Nom du produit
                    input#name(
                        type="text"
                        name="name"
                        value=product.name
                        required
                        maxlength="200"
                    )

            .form-row

                .form-group
                    label(for="category_id") Catégorie

                    select#category_id(
                        name="category_id"
                    )
                        option(value="") -- Aucune catégorie --

                        each category in categories
                            option(
                                value=category.id
                                selected=String(product.category_id) === String(category.id)
                            )= category.name

                .form-group
                    label(for="unit") Unité

                    select#unit(name="unit")
                        option(
                            value="piece"
                            selected=product.unit === 'piece'
                        ) Pièce

                        option(
                            value="kg"
                            selected=product.unit === 'kg'
                        ) Kilogramme

                        option(
                            value="g"
                            selected=product.unit === 'g'
                        ) Gramme

                        option(
                            value="litre"
                            selected=product.unit === 'litre'
                        ) Litre

                        option(
                            value="metre"
                            selected=product.unit === 'metre'
                        ) Mètre

                        option(
                            value="carton"
                            selected=product.unit === 'carton'
                        ) Carton

            .form-row

                .form-group
                    label(for="purchase_price") Prix d'achat
                    input#purchase_price(
                        type="number"
                        name="purchase_price"
                        value=product.purchase_price
                        min="0"
                        step="0.01"
                        required
                    )

                .form-group
                    label(for="sale_price") Prix de vente
                    input#sale_price(
                        type="number"
                        name="sale_price"
                        value=product.sale_price
                        min="0"
                        step="0.01"
                        required
                    )

            .form-row

                .form-group
                    label(for="minimum_stock") Stock minimum

                    input#minimum_stock(
                        type="number"
                        name="minimum_stock"
                        value=product.minimum_stock
                        min="0"
                        step="0.01"
                        required
                    )

                .form-group
                    label(for="status") Statut

                    select#status(name="status")
                        option(
                            value="active"
                            selected=product.status === 'active'
                        ) Actif

                        option(
                            value="inactive"
                            selected=product.status === 'inactive'
                        ) Inactif

            .form-group
                label(for="description") Description

                textarea#description(
                    name="description"
                    rows="5"
                    maxlength="1000"
                )= product.description || ''

            .form-section

                h3 Fournisseurs

                p.form-help
                    | Sélectionnez les fournisseurs associés à ce produit.

                if suppliers.length
                    .permission-grid
                        each supplier in suppliers
                            label.permission-item
                                input(
                                    type="checkbox"
                                    name="supplier_ids"
                                    value=supplier.id
                                    checked=product.supplier_ids.map(String).includes(String(supplier.id))
                                )

                                span.permission-content
                                    strong= supplier.name
                                    span= supplier.code
                else
                    p.text-muted
                        | Aucun fournisseur disponible.

            .form-actions

                a.btn.btn-secondary(
                    href="/products"
                )
                    | Annuler

                button.btn.btn-primary(
                    type="submit"
                )
                    | Enregistrer