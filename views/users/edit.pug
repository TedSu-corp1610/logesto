extends ../layouts/main

block content

    .form-page

        .panel.form-panel

            .panel-header

                h2
                    | Modifier l'utilisateur

            .panel-body

                form(
                    action=`/users/${userToEdit.id}/edit`
                    method="POST"
                )

                    .form-grid

                        .form-group

                            label(
                                for="username"
                            )
                                | Nom d'utilisateur

                            input.form-control(
                                type="text"
                                id="username"
                                name="username"
                                value=userToEdit.username
                                required
                            )


                        .form-group

                            label(
                                for="email"
                            )
                                | Adresse email

                            input.form-control(
                                type="email"
                                id="email"
                                name="email"
                                value=userToEdit.email
                                required
                            )


                        .form-group

                            label(
                                for="role_id"
                            )
                                | Rôle

                            select.form-control(
                                id="role_id"
                                name="role_id"
                                required
                            )

                                each role in roles

                                    option(
                                        value=role.id
                                        selected=Number(role.id) === Number(userToEdit.role_id)
                                    )
                                        | #{role.name}


                    .form-actions

                        a.btn.btn-secondary(
                            href="/users"
                        )
                            | Annuler

                        button.btn.btn-primary(
                            type="submit"
                        )
                            | Enregistrer